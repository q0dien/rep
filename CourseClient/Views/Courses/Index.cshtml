@model List<CourseClient.Models.CourseViewModel>

@{
    ViewData["Title"] = "Список курсов";
}

<div class="container mt-4">
    <h1 style="font-size: 42px; font-weight: 700;">
        Список курсов
    </h1>

    <p style="font-size: 20px;">
        Данные загружаются из Course Management API.
    </p>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info mt-4" style="font-size: 22px;">
            Пока курсов нет.
        </div>
    }
    else
    {
        <div class="row mt-4">
            @foreach (var course in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h2 style="font-size: 28px; font-weight: 700;">
                                @course.Name
                            </h2>

                            <p style="font-size: 19px;">
                                Преподаватель: @course.Teacher
                            </p>

                            <p style="font-size: 19px;">
                                Кредиты: @course.Credits
                            </p>

                            <a asp-controller="Courses"
                               asp-action="Details"
                               asp-route-id="@course.Id"
                               class="btn btn-primary btn-lg">
                                Подробнее
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
